# 运行时环境变量示例（可选；均由服务进程读取，不要把真实值提交进仓库）

# --- REST API (mi-fitness-mcp api) / Web 仪表盘 (mi-fitness-mcp web) ---
# 设置后所有数据端点要求 X-API-Key 头
# MI_FITNESS_API_KEY=change-me
# 管理端点（Key 发放/列表/吊销、扫码登录）要求 X-Admin-Key；未设置时仅限 127.0.0.1 调用
# MI_FITNESS_ADMIN_KEY=change-me

# --- Web 仪表盘 (mi-fitness-mcp web) ---
# MI_FITNESS_API_URL=http://127.0.0.1:8321   # 反向代理的后端 FastAPI 地址

# --- Rust 测试页 (testpage/) ---
# BIND=127.0.0.1:8322                         # 监听地址
# MI_FITNESS_API_URL=http://127.0.0.1:8321

# 小米凭据不走环境变量：用 mi-fitness-mcp setup（keyring 存储）或扫码登录发放 Key。
